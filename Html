<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NO WIPE - FiveM RP Server</title>
    <style>
        :root {
            --primary: #FFD700; /* Yellow */
            --secondary: #8A2BE2; /* Purple */
        }
        body {
            margin: 0; font-family: 'Segoe UI', sans-serif; background: #111; color: #eee;
            text-align: center;
        }
        header {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            padding: 4rem 1rem; color: #000;
        }
        .logo { max-width: 200px; margin-bottom: 1rem; }
        h1 { margin: 0; font-size: 3rem; }
        .connect-btn {
            background: #000; color: var(--primary); padding: 1rem 2rem;
            font-size: 1.2rem; border: none; border-radius: 50px; cursor: pointer;
            margin-top: 1rem;
        }
        section { padding: 3rem 1rem; max-width: 1100px; margin: 0 auto; }
        .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }
        .card { background: #222; padding: 1.5rem; border-radius: 12px; }
        footer { background: #000; padding: 2rem; }
    </style>
</head>
<body>
    <header>
        <img src="logo.png" alt="NO WIPE Logo" class="logo"> <!-- Upload your yellow/purple logo as logo.png -->
        <h1>NO WIPE</h1>
        <p>Serious GTA V Roleplay • QBox • Custom Heists • ox_inventory</p>
        <button class="connect-btn" onclick="copyConnect()">CONNECT TO SERVER</button>
    </header>

    <section>
        <h2>Why Join NO WIPE?</h2>
        <div class="features">
            <div class="card">
                <h3>🔄 No Wipe Policy</h3>
                <p>Build your story without resets.</p>
            </div>
            <div class="card">
                <h3>🛠️ Custom Scripts</h3>
                <p>QBox framework, ox_inventory, K4MB1 drills, and more.</p>
            </div>
            <div class="card">
                <h3>💰 Economy & Heists</h3>
                <p>Balanced economy with exciting Lunar Heist Contracts.</p>
            </div>
        </div>
    </section>

    <section style="background:#1a1a1a;">
        <h2>Server Info</h2>
        <p><strong>IP:</strong> YOUR_SERVER_IP:PORT (replace this)</p>
        <p><strong>Discord:</strong> <a href="YOUR_DISCORD_LINK" style="color:var(--primary)">Join Here</a></p>
    </section>

    <footer>
        <p>&copy; NO WIPE RP • North Olmsted / Cleveland Area Vibes</p>
    </footer>

    <script>
        function copyConnect() {
            navigator.clipboard.writeText("connect YOUR_SERVER_IP:PORT");
            alert("Connect command copied! Paste in F8 in FiveM.");
        }
    </script>
</body>
</html>
